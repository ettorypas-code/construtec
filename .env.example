# =============================================================================
#  CONSTRUTEC — variáveis de ambiente
#
#  Copie para `.env` no desenvolvimento. Em produção, cadastre na Vercel em
#  Settings → Environment Variables. Nada aqui vai para o navegador, exceto o
#  que tem prefixo NEXT_PUBLIC_ — e nenhuma dessas é credencial.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO — PostgreSQL (Supabase)
#
# Supabase → Connect → duas strings, ambas do POOLER:
#   DATABASE_URL = "Transaction pooler" (6543) — usada pela aplicação
#   DIRECT_URL   = "Session pooler"     (5432) — usada pelas migrações
#
# Duas porque o transaction pooler não suporta os comandos que a migração usa.
#
# NÃO use a "Direct connection" (db.xxx.supabase.co) em DIRECT_URL: ela tem
# apenas registro DNS AAAA, existindo só em IPv6. A Vercel é IPv4 e o build
# falha com "P1001: Can't reach database server". O session pooler é IPv4.
#
# Troque [YOUR-PASSWORD] pela senha definida na criação do projeto.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# SESSÃO — troque antes de publicar
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
SESSION_SECRET="troque-esta-chave-por-uma-aleatoria-de-64-caracteres"

# Chave de criptografia das server actions. Sem ela, cada deploy invalida as
# ações abertas no navegador de quem estiver usando o app naquele momento.
# Gere do mesmo jeito que a de cima.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# URL pública. Os links de proposta enviados ao cliente dependem dela.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# ARQUIVOS
#   local     → grava em ./storage (só desenvolvimento)
#   supabase  → Supabase Storage, bucket PRIVADO
#
# Supabase → Project Settings → API:
#   SUPABASE_URL              = Project URL
#   SUPABASE_SERVICE_ROLE_KEY = service_role (secreta — nunca no cliente)
# -----------------------------------------------------------------------------
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="construtec"

# -----------------------------------------------------------------------------
# RESUMO DIÁRIO
# Token do agendador que chama /api/resumo-diario. Sem ele, o endpoint só
# responde para quem tem sessão aberta. Gere do mesmo jeito que SESSION_SECRET.
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# IA (opcional)
# Sem a chave o sistema funciona igual: os botões de sugestão não aparecem.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# -----------------------------------------------------------------------------
# Usuário administrador criado pelo seed
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@construtec.local"
SEED_ADMIN_PASSWORD="construtec123"
SEED_ADMIN_NAME="Administrador"
